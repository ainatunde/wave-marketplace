# Environment Variables Example for Medusa, Next.js, Paystack, Flutterwave, AWS, and Database Configuration

# Medusa Backend
MEDUSA_BACKEND_URL=https://your-backend-url.com
MEDUSA_ADMIN_API_TOKEN=your_admin_api_token

# Next.js Frontend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-backend-url.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=your_s3_bucket_name

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
